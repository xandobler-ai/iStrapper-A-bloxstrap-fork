<Window x:Class="iStrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iStrapper" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Custom Fonts -->
        <FontFamily x:Key="iStrapperFont">pack://application:,,,/Fonts/#iStrapperFont</FontFamily>
        
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#5865F2"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#2D333B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#00FF88"/>
        <SolidColorBrush x:Key="DangerColor" Color="#FF4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFAA00"/>
        
        <!-- Styles -->
        <Style x:Key="iStrapperButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="iStrapperTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        
        <Style x:Key="iStrapperTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" 
                            Background="{StaticResource PrimaryColor}"
                            CornerRadius="8"
                            Margin="0,0,15,0">
                        <TextBlock Text="iS" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="iStrapper" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   FontFamily="{StaticResource iStrapperFont}"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="Ready" 
                                   Foreground="#8B949E" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#21262D" 
                            CornerRadius="15" 
                            Padding="10,5"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="VersionText" 
                                   Text="v1.0.0" 
                                   Foreground="{StaticResource AccentColor}" 
                                   FontSize="13"/>
                    </Border>
                    <Button Content="⟳ Check Updates" 
                            Click="CheckUpdates_Click"
                            Background="{StaticResource PrimaryColor}" 
                            Style="{StaticResource iStrapperButton}"
                            Height="35"
                            Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="10" Background="Transparent">
            <!-- Main Tab -->
            <TabItem Header="🏠 Main" Style="{StaticResource iStrapperTabItem}">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                        <StackPanel>
                            <!-- GitHub Repo -->
                            <Border Background="#161B22" 
                                    CornerRadius="10" 
                                    Padding="15" 
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="📦 GitHub Repository" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="White" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Repository:" Foreground="#8B949E"/>
                                    <TextBox x:Name="RepoUrlBox" 
                                             Text="YOUR_USERNAME/iStrapper" 
                                             Margin="0,5,0,10"
                                             Style="{StaticResource iStrapperTextBox}"/>
                                    <TextBlock Text="Latest Release:" Foreground="#8B949E"/>
                                    <TextBlock x:Name="LatestReleaseText" 
                                               Text="Checking..." 
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Installation -->
                            <Border Background="#161B22" 
                                    CornerRadius="10" 
                                    Padding="15" 
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="📁 Installation" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="White" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Installation Path:" Foreground="#8B949E"/>
                                    <TextBox x:Name="InstallPathBox" 
                                             Text="C:\Roblox" 
                                             Margin="0,5,0,10"
                                             Style="{StaticResource iStrapperTextBox}"/>
                                    <TextBlock Text="Installed Version:" Foreground="#8B949E"/>
                                    <TextBlock x:Name="InstalledVersionText" 
                                               Text="Not installed" 
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- DLL Injection -->
                            <Border Background="#161B22" 
                                    CornerRadius="10" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="💉 DLL Injection" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="White" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="DLL to inject:" Foreground="#8B949E"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBox x:Name="DllPathBox" 
                                                 Width="250"
                                                 Style="{StaticResource iStrapperTextBox}"
                                                 Text=""/>
                                        <Button Content="📂 Browse..." 
                                                Click="BrowseDll_Click"
                                                Margin="5,0,0,0"
                                                Padding="10,5"
                                                Style="{StaticResource iStrapperButton}"
                                                Background="#30363D"
                                                Height="35"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Panel -->
                    <StackPanel Grid.Column="1">
                        <Button Content="⬇️ Download from GitHub" 
                                Click="DownloadFromGitHub_Click"
                                Background="#24292E" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="📥 Install Roblox" 
                                Click="InstallRoblox_Click"
                                Background="#238636" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="🎨 Apply Mods" 
                                Click="ApplyMods_Click"
                                Background="{StaticResource WarningColor}" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="🚀 Launch Roblox" 
                                Click="LaunchRoblox_Click"
                                Background="#CA5010" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="💉 Inject DLL" 
                                Click="InjectDll_Click"
                                Background="{StaticResource DangerColor}" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="🛑 Kill Roblox" 
                                Click="KillRoblox_Click"
                                Background="#6E7681" 
                                Style="{StaticResource iStrapperButton}"/>
                        
                        <!-- Update Info -->
                        <Border Background="#161B22" 
                                BorderBrush="#30363D" 
                                BorderThickness="1" 
                                CornerRadius="10"
                                Margin="0,20,0,0"
                                Padding="15">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Update Info" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="UpdateInfoText" 
                                           Text="No updates available" 
                                           Foreground="#8B949E" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Mods Tab -->
            <TabItem Header="🎨 Mods" Style="{StaticResource iStrapperTabItem}">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mod List -->
                    <Border Grid.Column="0" Background="#161B22" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Installed Mods" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>
                            <ListBox x:Name="ModListBox" 
                                     Background="#21262D" 
                                     Foreground="White"
                                     BorderBrush="#30363D"
                                     BorderThickness="1"
                                     MaxHeight="400">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <CheckBox IsChecked="{Binding Enabled}" 
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Bold" 
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding Description}" 
                                                           Foreground="#8B949E" 
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Mod Controls -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <Button Content="📂 Open Mods Folder" 
                                Click="OpenModsFolder_Click"
                                Background="{StaticResource PrimaryColor}" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="🔄 Refresh Mods" 
                                Click="RefreshMods_Click"
                                Background="#30363D" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="➕ Install Mod" 
                                Click="InstallMod_Click"
                                Background="#238636" 
                                Style="{StaticResource iStrapperButton}"/>
                        <Button Content="🗑️ Remove Selected" 
                                Click="RemoveMod_Click"
                                Background="{StaticResource DangerColor}" 
                                Style="{StaticResource iStrapperButton}"/>
                        
                        <Border Background="#161B22" 
                                CornerRadius="10" 
                                Padding="15" 
                                Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="⚙️ Mod Settings" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="Mod Priority:" Foreground="#8B949E"/>
                                <ComboBox x:Name="PriorityBox" 
                                          Background="#21262D" 
                                          Foreground="White"
                                          Margin="0,5,0,10">
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Low"/>
                                </ComboBox>
                                <TextBlock Text="Apply Order:" Foreground="#8B949E"/>
                                <TextBox x:Name="OrderBox" 
                                         Text="1,2,3,4,5" 
                                         Style="{StaticResource iStrapperTextBox}"
                                         Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="⚙️ Settings" Style="{StaticResource iStrapperTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- FPS Settings -->
                        <Border Background="#161B22" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🎮 FPS Settings" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="FPS Limit:" Foreground="#8B949E"/>
                                <Slider x:Name="FpsSlider" 
                                        Minimum="30" 
                                        Maximum="360" 
                                        Value="60"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,10,0,5"
                                        Foreground="{StaticResource AccentColor}"/>
                                <TextBlock x:Name="FpsValueText" 
                                           Text="60 FPS" 
                                           Foreground="{StaticResource AccentColor}" 
                                           FontSize="20" 
                                           FontWeight="Bold"/>
                                <CheckBox x:Name="UnlockFpsCheck" 
                                          Content="🔓 Unlock FPS (remove limit)" 
                                          Foreground="White"
                                          Margin="0,10,0,0"/>
                                <Button Content="✅ Apply FPS Settings" 
                                        Click="ApplyFps_Click"
                                        Background="{StaticResource PrimaryColor}" 
                                        Style="{StaticResource iStrapperButton}"
                                        Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Graphics Settings -->
                        <Border Background="#161B22" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🖥️ Graphics Settings" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Graphics Quality:" Foreground="#8B949E"/>
                                <ComboBox x:Name="GraphicsQualityBox" 
                                          Background="#21262D" 
                                          Foreground="White"
                                          Margin="0,5,0,10">
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="High" IsSelected="True"/>
                                    <ComboBoxItem Content="Ultra"/>
                                </ComboBox>
                                <CheckBox x:Name="DisableShadowsCheck" 
                                          Content="🚫 Disable Shadows" 
                                          Foreground="White"/>
                                <CheckBox x:Name="DisableEffectsCheck" 
                                          Content="🚫 Disable Effects" 
                                          Foreground="White"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Font Settings -->
                        <Border Background="#161B22" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🔤 Font Settings" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="UI Font:" Foreground="#8B949E"/>
                                <ComboBox x:Name="FontBox" 
                                          Background="#21262D" 
                                          Foreground="White"
                                          Margin="0,5,0,10"
                                          SelectionChanged="FontBox_SelectionChanged">
                                    <ComboBoxItem Content="Default"/>
                                    <ComboBoxItem Content="iStrapper Font"/>
                                    <ComboBoxItem Content="Mono"/>
                                </ComboBox>
                                <TextBlock Text="Font Size:" Foreground="#8B949E"/>
                                <Slider x:Name="FontSizeSlider" 
                                        Minimum="10" 
                                        Maximum="24" 
                                        Value="14"
                                        Margin="0,10,0,5"
                                        Foreground="{StaticResource AccentColor}"/>
                                <TextBlock x:Name="FontSizeText" 
                                           Text="14px" 
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- iOS Settings -->
                        <Border Background="#161B22" 
                                CornerRadius="10" 
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="📱 iOS Settings" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           Margin="0,0,0,15"/>
                                <CheckBox x:Name="EnableiOSCheck" 
                                          Content="📱 Enable iOS Compatibility Mode" 
                                          Foreground="White"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="iOS Device:" Foreground="#8B949E"/>
                                <ComboBox x:Name="iOSDeviceBox" 
                                          Background="#21262D" 
                                          Foreground="White"
                                          Margin="0,5,0,10">
                                    <ComboBoxItem Content="iPhone"/>
                                    <ComboBoxItem Content="iPad"/>
                                    <ComboBoxItem Content="iPod"/>
                                </ComboBox>
                                <TextBlock Text="iOS Version:" Foreground="#8B949E"/>
                                <TextBox x:Name="iOSVersionBox" 
                                         Text="17.0" 
                                         Style="{StaticResource iStrapperTextBox}"
                                         Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Progress -->
        <ProgressBar x:Name="ProgressBar" 
                     Grid.Row="2" 
                     Height="4" 
                     Margin="10,0,10,10"
                     Foreground="{StaticResource AccentColor}"
                     Background="#21262D"/>

        <!-- Log -->
        <Border Grid.Row="3" Background="#0D
